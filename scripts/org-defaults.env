# Corporate defaults: the AWS region, VPC, and subnets every developer
# deploys their dev environment into. scripts/init.sh sources this and
# offers each value as a default — press Enter at the prompt to accept it,
# or type something else to override it for a project that genuinely needs
# a different VPC.
#
# Update these in one place if the corporate dev VPC/subnets ever change.
DEFAULT_AWS_REGION="us-east-1"
DEFAULT_VPC_ID="vpc-03de7ad5a4c7c1822"
DEFAULT_SUBNET_IDS="subnet-02615277a84a5fcb4,subnet-005d1ad197eb59c2b"
